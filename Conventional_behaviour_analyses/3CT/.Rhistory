.groups = "drop"
)
glimpse(hemisphere_summary)
library(pacman)
p_load(lmerTest)
conflicts_prefer(lmerTest::lmer)
model_puncta <- lmer(
synapses_per_cm2 ~ group + (1 | mouse_id) + (1 | allen_section),
data = hemisphere_summary
)
summary(model_puncta)
p_val <- anova(model_puncta)["group", "Pr(>F)"]
print(paste("p-value for group effect:", signif(p_val, 3)))
# Model diagnostics
qqnorm(residuals(model_puncta)); qqline(residuals(model_puncta))
shapiro.test(residuals(model_puncta))
p_load(broom.mixed, openxlsx)
model_df <- broom.mixed::tidy(model_puncta, effects = "fixed") %>%
filter(term == "groupTDP-43")
n_bio <- hemisphere_summary %>%
distinct(mouse_id, group) %>%
count(group, name = "n_mice") %>%
summarise(txt = paste0(group, "=", n_mice, collapse = " | ")) %>%
pull(txt)
n_tech_group <- hemisphere_summary %>%
count(group, name = "n_hemispheres") %>%
summarise(txt = paste0(group, ": hemispheres=", n_hemispheres, collapse = " | ")) %>%
pull(txt)
tech_mouse <- hemisphere_summary %>%
group_by(group, mouse_id) %>%
summarise(n_hemispheres = n(), .groups = "drop") %>%
arrange(group, mouse_id)
results_table <- model_df %>%
mutate(
stats             = paste0(
"contrast: WT–TDP-43; β = ", round(estimate, 2),
", SE = ", round(std.error, 2),
", t(", round(df, 0), ") = ", round(statistic, 3),
", p = ", signif(p.value, 3)
),
DV                = "synapses_per_cm2",
model             = "lmer(synapses_per_cm2 ~ group + (1 | mouse_id) + (1 | allen_section))",
`N (biological)`  = n_bio,
`n (technical)`   = n_tech_group,
`p-value`         = paste0("p = ", signif(p.value, 3))
) %>%
select(stats, DV, model, `N (biological)`, `n (technical)`, `p-value`)
conflicts_prefer(dplyr::select)
results_table <- model_df %>%
mutate(
stats             = paste0(
"contrast: WT–TDP-43; β = ", round(estimate, 2),
", SE = ", round(std.error, 2),
", t(", round(df, 0), ") = ", round(statistic, 3),
", p = ", signif(p.value, 3)
),
DV                = "synapses_per_cm2",
model             = "lmer(synapses_per_cm2 ~ group + (1 | mouse_id) + (1 | allen_section))",
`N (biological)`  = n_bio,
`n (technical)`   = n_tech_group,
`p-value`         = paste0("p = ", signif(p.value, 3))
) %>%
select(stats, DV, model, `N (biological)`, `n (technical)`, `p-value`)
results_table
write.xlsx(results_table, file = "VGAT_puncta_per_cm2_stats.xlsx", rowNames = FALSE)
hemisphere_summary$mouse_id <- as.factor(hemisphere_summary$mouse_id)
library(ggplot2)
library(ggdist)
library(colorspace)
hemisphere_summary$mouse_id <- as.factor(hemisphere_summary$mouse_id)
library(ggplot2)
library(ggdist)
library(colorspace)
conflicts_prefer(dplyr::filter)
hemisphere_summary <- hemisphere_summary %>%
mutate(
group      = as.factor(group),
mouse_id   = as.factor(mouse_id),
mouse_label = paste0(group, ": ", mouse_id)
)
mean_per_mouse <- hemisphere_summary %>%
group_by(mouse_id, group) %>%
summarise(
mean_density = mean(synapses_per_cm2, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(mouse_label = paste0(group, ": ", mouse_id))
mouse_group_df <- hemisphere_summary %>% distinct(mouse_id, group, mouse_label)
wt_labels      <- mouse_group_df %>% filter(group == "WT")  %>% pull(mouse_label)
tdp_labels     <- mouse_group_df %>% filter(group == "TDP-43") %>% pull(mouse_label)
wt_cols  <- sequential_hcl(length(wt_labels),  palette = "Oranges")
tdp_cols <- sequential_hcl(length(tdp_labels), palette = "Purples")
if (length(wt_cols)  > 0) wt_cols[length(wt_cols)]   <- "#000000"
if (length(tdp_cols) > 0) tdp_cols[length(tdp_cols)] <- "#000000"
mouse_colors <- c(setNames(wt_cols, wt_labels), setNames(tdp_cols, tdp_labels))
p_val    <- anova(model_puncta)["group", "Pr(>F)"]
p_label  <- paste0("p = ", signif(p_val, 3))
shift    <- 0.10
y_max    <- max(hemisphere_summary$synapses_per_cm2, na.rm = TRUE)
y_range  <- diff(range(hemisphere_summary$synapses_per_cm2, na.rm = TRUE))
bracket_y     <- y_max + 0.06 * y_range
bracket_y_low <- y_max + 0.03 * y_range
text_y        <- y_max + 0.10 * y_range
plot_puncta <- ggplot() +
stat_halfeye(
data = hemisphere_summary,
aes(x = group, y = synapses_per_cm2, fill = group),
side = "left", adjust = 0.5, justification = 1.05,
.width = 0, point_colour = NA, alpha = 0.6, scale = 0.6,
position = position_nudge(x = 0.025)
) +
geom_point(
data = hemisphere_summary,
aes(x = as.numeric(group) + shift, y = synapses_per_cm2, color = mouse_label),
position = position_jitter(width = 0.03, height = 0),
size = 1.6, alpha = 0.6
) +
geom_point(
data = mean_per_mouse,
aes(x = as.numeric(group) + shift + 0.10, y = mean_density, color = mouse_label),
position = position_jitter(width = 0.02, height = 0),
size = 3, alpha = 0.95, stroke = 0.6
) +
stat_summary(
data = hemisphere_summary,
aes(x = group, y = synapses_per_cm2),
fun = mean, geom = "point", size = 3, color = "black"
) +
stat_summary(
data = hemisphere_summary,
aes(x = group, y = synapses_per_cm2),
fun.data = mean_se, geom = "errorbar", width = 0.12, color = "black"
) +
annotate("segment", x = 1, xend = 2, y = bracket_y,     yend = bracket_y,     linewidth = 0.8) +
annotate("segment", x = 1, xend = 1, y = bracket_y_low, yend = bracket_y,     linewidth = 0.8) +
annotate("segment", x = 2, xend = 2, y = bracket_y_low, yend = bracket_y,     linewidth = 0.8) +
annotate("text",    x = 1.5,          y = text_y,        label = p_label, size = 5) +
scale_fill_manual(values = c("WT" = "#feca8d", "TDP-43" = "#440f76"), guide = "none") +
scale_color_manual(values = mouse_colors, name = "Mouse ID") +
guides(color = guide_legend(override.aes = list(size = 3, alpha = 1))) +
labs(x = "Group", y = "VGAT synapses / cm²") +
theme_bw() +
theme(text = element_text(size = 16), legend.position = "right")
plot_puncta
ggsave("VGAT_synapse_density_per_cm2.svg", plot = plot_puncta, width = 8, height = 6)
