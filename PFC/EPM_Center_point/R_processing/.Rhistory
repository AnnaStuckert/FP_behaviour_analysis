# Helper function
# =========================
p_to_stars <- function(p) {
case_when(
is.na(p) ~ "n/a",
p < 0.001 ~ "***",
p < 0.01 ~ "**",
p < 0.05 ~ "*",
TRUE ~ "ns"
)
}
# =========================
# Main plotting and model function
# =========================
run_lmer_plot <- function(stim_name, geno_name) {
# -------------------------
# Filter to one plot
# -------------------------
sub <- df %>%
filter(
stim == stim_name,
genotype == geno_name,
week %in% c("Preinduction", "W1", "W2")
)
if (nrow(sub) == 0) {
message("No data for ", stim_name, " | ", geno_name)
return(NULL)
}
# -------------------------
# Average only replicate videos
# Unit after this:
# one row per mouse_id x timepoint
#
# This pools Preinduction because all Preinduction dates
# were coded as timepoint == "Preinduction".
#
# It does NOT pool W1 or W2, because their timepoint is date.
# -------------------------
agg <- sub %>%
group_by(mouse_id, timepoint, week) %>%
summarise(
post_mean = mean(post_mean, na.rm = TRUE),
n_videos = n(),
.groups = "drop"
)
# -------------------------
# Order timepoints:
# Preinduction first, then W1 dates, then W2 dates
# -------------------------
ordered_timepoints <- agg %>%
distinct(timepoint, week) %>%
mutate(
sort_group = case_when(
timepoint == "Preinduction" ~ 0,
week == "W1" ~ 1,
week == "W2" ~ 2,
TRUE ~ 3
)
) %>%
arrange(sort_group, timepoint) %>%
pull(timepoint)
agg <- agg %>%
mutate(
timepoint = factor(timepoint, levels = ordered_timepoints),
mouse_id = factor(mouse_id),
week = factor(week, levels = c("Preinduction", "W1", "W2"))
) %>%
droplevels()
# -------------------------
# Safety checks
# -------------------------
if (!"Preinduction" %in% levels(agg$timepoint)) {
message("No Preinduction control for ", stim_name, " | ", geno_name)
return(NULL)
}
if (n_distinct(agg$timepoint) < 2) {
message("Too few timepoints for ", stim_name, " | ", geno_name)
return(NULL)
}
if (n_distinct(agg$mouse_id) < 2) {
message("Too few mice for ", stim_name, " | ", geno_name)
return(NULL)
}
# =========================
# Linear mixed model
# =========================
m_anova <- lmerTest::lmer(
post_mean ~ timepoint + (1 | mouse_id),
data = agg
)
print(paste("Model:", stim_name, geno_name))
print(summary(m_anova))
# =========================
# Emmeans + Dunnett contrasts
# Each W1/W2 date is compared with pooled Preinduction
# =========================
emmeans_results <- emmeans(m_anova, ~ timepoint)
dunnett_results <- contrast(
emmeans_results,
method = "trt.vs.ctrl",
ref = 1,
adjust = "dunnett"
)
dunnett_table <- as.data.frame(summary(dunnett_results, infer = TRUE))
print(dunnett_table)
# =========================
# Summary stats for plotting
# =========================
summary_df <- agg %>%
group_by(timepoint, week) %>%
summarise(
mean = mean(post_mean, na.rm = TRUE),
se = sd(post_mean, na.rm = TRUE) / sqrt(n()),
n = n(),
.groups = "drop"
)
# =========================
# Significance annotation
# =========================
dunnett_table <- dunnett_table %>%
mutate(
timepoint = str_remove(contrast, " - Preinduction"),
label = p_to_stars(p.value)
) %>%
left_join(
summary_df %>%
mutate(timepoint = as.character(timepoint)) %>%
select(timepoint, mean, se),
by = "timepoint"
)
y_max <- max(summary_df$mean + summary_df$se, na.rm = TRUE)
y_pad <- ifelse(y_max > 0, y_max * 0.14, 1)
dunnett_table <- dunnett_table %>%
mutate(
y = mean + se + y_pad
)
# =========================
# Plot
# =========================
plot_bar <- ggplot(summary_df, aes(x = timepoint, y = mean, fill = week)) +
geom_col(width = 0.6, color = "black", alpha = 0.85) +
geom_errorbar(
aes(ymin = mean - se, ymax = mean + se),
width = 0.15,
linewidth = 0.8
) +
geom_jitter(
data = agg,
aes(x = timepoint, y = post_mean),
inherit.aes = FALSE,
width = 0.00,
size = 2,
alpha = 0.6
) +
geom_line(
data = agg,
aes(x = timepoint, y = post_mean, group = mouse_id),
inherit.aes = FALSE,
color = "gray60",
alpha = 0.4,
linewidth = 0.6
) +
scale_fill_manual(values = c(
"Preinduction" = "#feca8d",
"W1" = "#f1605d",
"W2" = "#440f76"
)) +
labs(
title = paste(stim_name, geno_name, sep = " | "),
x = "Timepoint",
y = "Mean post-onset MAE"
) +
theme_bw(base_size = 14) +
theme(
legend.position = "none",
text = element_text(size = 14),
axis.text.x = element_text(angle = 45, hjust = 1)
) +
geom_text(
data = dunnett_table,
aes(x = timepoint, y = y, label = label),
inherit.aes = FALSE,
size = 5
)
plot_bar
# =========================
# Save figure and results
# =========================
file_stub <- paste0("MAE_longitudinal_", stim_name, "_", geno_name)
ggsave(
filename = file.path(out_dir, paste0(file_stub, ".svg")),
plot = plot_bar,
width = max(8, length(ordered_timepoints) * 1.2),
height = 6
)
ggsave(
filename = file.path(out_dir, paste0(file_stub, ".png")),
plot = plot_bar,
width = max(8, length(ordered_timepoints) * 1.2),
height = 6,
dpi = 300
)
write_csv(
agg,
file.path(out_dir, paste0(file_stub, "_mouse_timepoint_values.csv"))
)
write_csv(
summary_df,
file.path(out_dir, paste0(file_stub, "_summary_stats.csv"))
)
write_csv(
dunnett_table,
file.path(out_dir, paste0(file_stub, "_dunnett_results.csv"))
)
return(list(
model = m_anova,
emmeans = emmeans_results,
dunnett = dunnett_table,
plot = plot_bar,
summary = summary_df,
data = agg
))
}
# ============================================================
# Run all plots
# ============================================================
STIMS <- c("Airpuff", "Sucrose", "Quinine")
GENOTYPES <- c("WT", "TDP")
results <- list()
for (s in STIMS) {
for (g in GENOTYPES) {
results[[paste(s, g, sep = "_")]] <- run_lmer_plot(s, g)
}
}
knitr::opts_chunk$set(echo = TRUE)
# ============================================================
# Longitudinal MAE plots
# Preinduction pooled, W1/W2 dates kept separate
# LMER + Dunnett in R
# ============================================================
# =========================
# Libraries
# =========================
library(pacman)
p_load(tidyverse, readr, lmerTest, emmeans, ggplot2, performance)
# =========================
# Load Python output
# =========================
df <- read_csv("per_video_records.csv")
# =========================
# Rename variables
# =========================
df <- df %>%
rename(
genotype = group,
mouse_id = mouse
)
# =========================
# Format variables
# =========================
df <- df %>%
mutate(
stim = factor(stim),
genotype = factor(genotype),
mouse_id = factor(mouse_id),
date = as.character(date),
week = factor(week, levels = c("Preinduction", "W1", "W2")),
# IMPORTANT:
# Only Preinduction is pooled.
# Every W1/W2 date stays separate.
timepoint = if_else(week == "Preinduction", "Preinduction", date)
)
# =========================
# Output folder
# =========================
out_dir <- "R_LMER_Longitudinal_Plots"
dir.create(out_dir, showWarnings = FALSE)
# =========================
# Helper function
# =========================
p_to_stars <- function(p) {
case_when(
is.na(p) ~ "n/a",
p < 0.001 ~ "***",
p < 0.01 ~ "**",
p < 0.05 ~ "*",
TRUE ~ "ns"
)
}
# =========================
# Main plotting and model function
# =========================
run_lmer_plot <- function(stim_name, geno_name) {
# -------------------------
# Filter to one plot
# -------------------------
sub <- df %>%
filter(
stim == stim_name,
genotype == geno_name,
week %in% c("Preinduction", "W1", "W2")
)
if (nrow(sub) == 0) {
message("No data for ", stim_name, " | ", geno_name)
return(NULL)
}
# -------------------------
# Average only replicate videos
# Unit after this:
# one row per mouse_id x timepoint
#
# This pools Preinduction because all Preinduction dates
# were coded as timepoint == "Preinduction".
#
# It does NOT pool W1 or W2, because their timepoint is date.
# -------------------------
agg <- sub %>%
group_by(mouse_id, timepoint, week) %>%
summarise(
post_mean = mean(post_mean, na.rm = TRUE),
n_videos = n(),
.groups = "drop"
)
# -------------------------
# Order timepoints:
# Preinduction first, then W1 dates, then W2 dates
# -------------------------
ordered_timepoints <- agg %>%
distinct(timepoint, week) %>%
mutate(
sort_group = case_when(
timepoint == "Preinduction" ~ 0,
week == "W1" ~ 1,
week == "W2" ~ 2,
TRUE ~ 3
)
) %>%
arrange(sort_group, timepoint) %>%
pull(timepoint)
agg <- agg %>%
mutate(
timepoint = factor(timepoint, levels = ordered_timepoints),
mouse_id = factor(mouse_id),
week = factor(week, levels = c("Preinduction", "W1", "W2"))
) %>%
droplevels()
# -------------------------
# Safety checks
# -------------------------
if (!"Preinduction" %in% levels(agg$timepoint)) {
message("No Preinduction control for ", stim_name, " | ", geno_name)
return(NULL)
}
if (n_distinct(agg$timepoint) < 2) {
message("Too few timepoints for ", stim_name, " | ", geno_name)
return(NULL)
}
if (n_distinct(agg$mouse_id) < 2) {
message("Too few mice for ", stim_name, " | ", geno_name)
return(NULL)
}
# =========================
# Linear mixed model
# =========================
m_anova <- lmerTest::lmer(
post_mean ~ timepoint + (1 | mouse_id),
data = agg
)
print(paste("Model:", stim_name, geno_name))
print(summary(m_anova))
# =========================
# Emmeans + Dunnett contrasts
# Each W1/W2 date is compared with pooled Preinduction
# =========================
emmeans_results <- emmeans(m_anova, ~ timepoint)
dunnett_results <- contrast(
emmeans_results,
method = "trt.vs.ctrl",
ref = 1,
adjust = "dunnett"
)
dunnett_table <- as.data.frame(summary(dunnett_results, infer = TRUE))
print(dunnett_table)
# =========================
# Summary stats for plotting
# =========================
summary_df <- agg %>%
group_by(timepoint, week) %>%
summarise(
mean = mean(post_mean, na.rm = TRUE),
se = sd(post_mean, na.rm = TRUE) / sqrt(n()),
n = n(),
.groups = "drop"
)
# =========================
# Significance annotation
# =========================
dunnett_table <- dunnett_table %>%
mutate(
timepoint = str_remove(contrast, " - Preinduction"),
label = p_to_stars(p.value)
) %>%
left_join(
summary_df %>%
mutate(timepoint = as.character(timepoint)) %>%
select(timepoint, mean, se),
by = "timepoint"
)
y_max <- max(summary_df$mean + summary_df$se, na.rm = TRUE)
y_pad <- ifelse(y_max > 0, y_max * 0.16, 1)
dunnett_table <- dunnett_table %>%
mutate(
y = mean + se + y_pad
)
# =========================
# Plot
# =========================
plot_bar <- ggplot(summary_df, aes(x = timepoint, y = mean, fill = week)) +
geom_col(width = 0.6, color = "black", alpha = 0.85) +
geom_errorbar(
aes(ymin = mean - se, ymax = mean + se),
width = 0.15,
linewidth = 0.8
) +
geom_jitter(
data = agg,
aes(x = timepoint, y = post_mean),
inherit.aes = FALSE,
width = 0.00,
size = 2,
alpha = 0.6
) +
geom_line(
data = agg,
aes(x = timepoint, y = post_mean, group = mouse_id),
inherit.aes = FALSE,
color = "gray60",
